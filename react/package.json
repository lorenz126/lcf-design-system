{
  "name": "@lcf/design",
  "version": "0.4.0-dev",
  "private": true,
  "license": "MIT",
  "description": "LCF Design System \u2014 React components, tokens and the locale layer for internal tools.",
  "repository": {
    "type": "git",
    "url": "https://github.com/lorenz126/lcf-design-system.git",
    "directory": "react"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "scripts/check-contrast.mjs",
    "src/tokens",
    "src/css",
    "src/components/**/*.css",
    "LICENSE",
    "README.md",
    "CONSUMING.md",
    "CHANGELOG.md"
  ],
  "exports": {
    "./css": "./src/css/index.css",
    "./tailwind": "./src/css/tailwind.css",
    "./tokens/*": "./src/tokens/*",
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme/index.js"
    },
    "./i18n": {
      "types": "./dist/i18n/index.d.ts",
      "import": "./dist/i18n/index.js"
    },
    "./hooks/*": {
      "types": "./dist/hooks/*.d.ts",
      "import": "./dist/hooks/*.js"
    },
    "./components/*": {
      "types": "./dist/components/*/index.d.ts",
      "import": "./dist/components/*/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "node scripts/build.mjs",
    "storybook": "storybook dev -p 6010",
    "build-storybook": "storybook build -o storybook-static",
    "test": "node scripts/check-contrast.mjs && node scripts/check-stories.mjs && node scripts/check-strings.mjs && vitest run && tsc -p tsconfig.json --noEmit && pnpm build && playwright test",
    "test:contrast": "node scripts/check-contrast.mjs",
    "test:stories": "node scripts/check-stories.mjs",
    "test:strings": "node scripts/check-strings.mjs",
    "test:unit": "vitest run",
    "test:types": "tsc -p tsconfig.json --noEmit",
    "test:e2e": "playwright test",
    "verify:consumer": "bash scripts/verify-consumer.sh"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.50.0",
    "radix-ui": "^1.7.0"
  },
  "devDependencies": {
    "@playwright/test": "~1.62.1",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^30.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "storybook": "^10.6.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "bin": {
    "lcf-check-contrast": "scripts/check-contrast.mjs"
  }
}
