{
  "name": "@lf/design",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxi dev .playground",
    "demo": "nuxi dev demo",
    "build": "nuxi build .playground",
    "generate": "nuxi generate .playground",
    "preview": "nuxi preview .playground",
    "test": "node scripts/check-contrast.mjs && node scripts/check-layers.mjs && node scripts/check-dialogs.mjs && node scripts/check-pages.mjs && node scripts/check-package.mjs && vitest run && pnpm test:types && pnpm test:e2e",
    "test:types": "nuxt typecheck --cwd .playground && nuxt typecheck --cwd demo",
    "test:e2e": "playwright test",
    "test:contrast": "node scripts/check-contrast.mjs",
    "test:layers": "node scripts/check-layers.mjs",
    "test:dialogs": "node scripts/check-dialogs.mjs",
    "test:pages": "node scripts/check-pages.mjs",
    "test:package": "node scripts/check-package.mjs",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "demo:build": "nuxi build demo"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "happy-dom": "^20.13.0",
    "nuxt": "^4.0.0",
    "typescript": "^5.6.0",
    "unplugin-auto-import": "^21.1.0",
    "vitest": "^4.1.11",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0",
    "vue-tsc": "^3.3.11"
  },
  "main": "./nuxt.config.ts",
  "files": [
    "tokens",
    "styles",
    "ui",
    "types",
    "plugins",
    "composables",
    "nuxt.config.ts",
    "README.md"
  ],
  "exports": {
    ".": "./nuxt.config.ts",
    "./tokens/*": "./tokens/*",
    "./ui/*": "./ui/*",
    "./styles/*": "./styles/*",
    "./composables/*": "./composables/*"
  },
  "dependencies": {
    "lucide-vue-next": "^1.0.0"
  },
  "peerDependencies": {
    "nuxt": "^4.0.0",
    "vue": "^3.5.0"
  }
}
